{"version":3,"kind":"Article","sha256":"88e332cae51caab7c7ec12d226db2347e97d015748ab210522e29a2c9ed783b5","slug":"templates.template-instructions","location":"/templates/template_instructions.md","dependencies":[],"frontmatter":{"title":"Template instructions","content_includes_title":false,"github":"https://github.com/ecmwf-projects/c3s2-eqc-quality-assessment","edit_url":null,"source_url":null,"numbering":{"title":{"offset":1}},"thumbnail":"/c3s2-eqc-quality-assessment/pr-preview/pr-684/build/logoline_c3s-a4ca4e971436cbfd7e2ace1ba13ffddd.svg","exports":[{"format":"md","filename":"template_instructions.md","url":"/c3s2-eqc-quality-assessment/pr-preview/pr-684/build/template_instruction-edfadf7c1c4e08ecf71c2699a0ec8ef5.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"image","url":"/c3s2-eqc-quality-assessment/pr-preview/pr-684/build/logoline_c3s-a4ca4e971436cbfd7e2ace1ba13ffddd.svg","alt":"logo","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"kKtm3MBmbC","urlSource":"../logoline_c3s.svg"},{"type":"admonition","kind":"note","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Note","key":"EK6ZO5qn1v"}],"key":"PQ7n1oaHyo"},{"type":"paragraph","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"If anything is unclear with the templates, or if you encounter any problems, please report them at ","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"QLTVpdf7TO"},{"type":"link","url":"https://github.com/ecmwf-projects/c3s2-eqc-quality-assessment/issues/164","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"GH164","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"NvQdJqtgTf"}],"urlSource":"https://github.com/ecmwf-projects/c3s2-eqc-quality-assessment/issues/164","data":{"kind":"issue","org":"ecmwf-projects","repo":"c3s2-eqc-quality-assessment","issue_number":"164"},"internal":false,"protocol":"github","key":"BU1E0moTyB"},{"type":"text","value":".","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"BZuUkcBESf"}],"key":"bsEaVb9pWz"}],"key":"LNsLkKx0z3"},{"type":"paragraph","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"Instructions for the ","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"pcnH8i9QhX"},{"type":"link","url":"/templates/template","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"Jupyter Notebook template for quality assessments","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"XEw3TfdF5Y"}],"urlSource":"./template.ipynb","dataUrl":"/templates.template.json","internal":true,"protocol":"file","key":"Ljark1eujK"},{"type":"text","value":". This template aims to ensure consistency in content and the look and feel of the assessment once it is included in the ","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"ERft3eB8JO"},{"type":"link","url":"https://ecmwf-projects.github.io/c3s2-eqc-quality-assessment/","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"Jupyter Book","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"nQw3uZYvGj"}],"urlSource":"https://ecmwf-projects.github.io/c3s2-eqc-quality-assessment/","key":"STjBBG0c2E"},{"type":"text","value":". The syntax includes MyST formatting needed for the Jupyter Book which will not render in all Jupyter Notebook viewers, or GitHub, but works in Jupyter Lab on the Virtual Machine.","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"r4sEoHWtu5"}],"key":"t3yKTFZ4Sr"},{"type":"admonition","kind":"note","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Note","key":"LQIOxQadCe"}],"key":"RRgWpPoGNM"},{"type":"paragraph","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"text","value":"Some additional formatting required for the Jupyter Book will be automatically applied when the page for a given assessment is built, and so are not included in the template. This includes the extraction of embedded images, ‘collapsing’ the code cells, and adding a logo line.","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"XFE0oY1EjC"}],"key":"o7RaYd0SfG"}],"key":"L1TT5WfD5N"},{"type":"admonition","kind":"note","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Note","key":"vP93Kuuzcg"}],"key":"o2ravcgomM"},{"type":"paragraph","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"text","value":"Please follow the headings and subheadings approach used in the template. The level of the heading is determined by the number of hashes before it (#Title, ##Use case, etc.). The following link should be helpful: ","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"ivwCNA9yb7"},{"type":"link","url":"https://mystmd.org/guide/quickstart-myst-markdown","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"text","value":"https://​mystmd​.org​/guide​/quickstart​-myst​-markdown","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"D20aaJ57oq"}],"urlSource":"https://mystmd.org/guide/quickstart-myst-markdown","key":"IEKQu2zNJ2"}],"key":"GXiI3f22ze"},{"type":"paragraph","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"text","value":"Also note that icons have been added to most of the headings. These are standardised so should be the same for each assessment.","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"qFoIph3PYM"}],"key":"zKJN5nIyO6"}],"key":"csX3WSVqQj"},{"type":"admonition","kind":"note","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"References in the text should be made in the format","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"AXx2vygF8H"},{"type":"inlineCode","value":"[[1]](https://doi.org/10.1038/s41598-018-20628-2))","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"ZMQiVn9ZmN"},{"type":"text","value":", using a doi link wherever possible. The links are checked when the book is built, and broken links will cause an error to be raised.","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"BaNa6KSsw1"}],"key":"SxcEygtqZb"}],"key":"Wtw4uHv9hk"},{"type":"heading","depth":2,"position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"text","value":"Assessment title (no icons)","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"hTMlnktud3"}],"identifier":"assessment-title-no-icons","label":"Assessment title (no icons)","html_id":"assessment-title-no-icons","implicit":true,"key":"xDwxAIKghi"},{"type":"paragraph","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"text","value":"We do not aim to be completely prescriptive about the title, it should be readable and descriptive, but also include some keywords to increase searchability, e.g. ","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"KMtEU0Q12T"},{"type":"emphasis","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"text","value":"Seasonal forecasts bias assessment for impact models","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"VejE8ZKnbq"}],"key":"b9JBrydPYf"},{"type":"text","value":".","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"Zn6nw6bS2F"}],"key":"oGY7nEmpAa"},{"type":"paragraph","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"It could include:","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"pzU8P4l3t6"}],"key":"A6SS5lDtik"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":31,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"text","value":"Data stream/ECV/variable/index","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"RTUEw9UZJh"}],"key":"eqaUeg68gk"},{"type":"text","value":": Satellite (observations), Insitu (observations), Reanalysis, Seasonal (Forecasts), Climate (projections)","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"tveLAOqw7H"}],"key":"aM3UemlZ6Q"}],"key":"pacsfaAXep"},{"type":"listItem","spread":true,"position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"text","value":"Quality area","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"ngYDqK2GvI"}],"key":"dtrX1kUqJE"},{"type":"text","value":": bias, forecast skill, completeness, intercomparison of X and Y, comparison to X, trend assessment, extremes, spatial/temporal resolution, reliability, accuracy, etc.","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"jLU1wZVWEk"}],"key":"LXVbo6gokw"}],"key":"ezRvTvhvL3"},{"type":"listItem","spread":true,"position":{"start":{"line":33,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"Application area","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"dccnpWbISh"}],"key":"IbvmGe8VVr"},{"type":"text","value":": impact models, risk assessment, climate monitoring, scientific study of X, Y sector, ‘region’, ‘specific C3S application’, flood forecasting, etc.","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"mESqIZFb7B"}],"key":"cdByGiYZMG"}],"key":"GaTQz4juCL"}],"key":"XrtEYbur2F"},{"type":"admonition","kind":"note","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Note","key":"KORS5NYReo"}],"key":"SGZSOZMc49"},{"type":"paragraph","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"children":[{"type":"text","value":"The title will be used in the table of contents for the data stream and the side bar of the Jupyter Book, so it needs to be unique, not too long, and help guide users to the assessment by mentioning the key analysis or outcomes. It will also be the title shown in the quality tab on the CDS.","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"key":"OYv7GZzH2Y"}],"key":"ZaZXgh9Y4F"}],"key":"Iyz1gNLxeY"},{"type":"admonition","kind":"note","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Note","key":"DNRDQXeUpQ"}],"key":"MoTnzlHfx3"},{"type":"paragraph","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"children":[{"type":"text","value":"The title should be the only ‘level one’ heading (single # before the heading), otherwise the other headings will also appear as separate links in the table of contents for the data stream and sidebar.","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"A3RczbWBRe"}],"key":"MvAdY1YX1i"}],"key":"H6nn77eUJJ"},{"type":"heading","depth":2,"position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"text","value":"Production date and author","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"WDE2Vz3sfe"}],"identifier":"production-date-and-author","label":"Production date and author","html_id":"production-date-and-author","implicit":true,"key":"t7M6kgGQis"},{"type":"paragraph","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"text","value":"Include a production date (approximating when the data was downloaded and code first run, or document first accessed). Optionally, the author(s) can be acknowledge, by name and/or institute, or instead ‘EQC evaluator’.","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"NpyeK4uRVw"}],"key":"aNxR2Ru3eE"},{"type":"heading","depth":2,"position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"text","value":"🌍 Use case","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"KvPYiQSaAQ"}],"identifier":"id-use-case","label":"🌍 Use case","html_id":"id-use-case","implicit":true,"key":"mkgMjuTIXC"},{"type":"paragraph","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"children":[{"type":"text","value":"The use case is listed directly in the heading of the section: ","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"key":"bbVNsJwyhM"},{"type":"inlineCode","value":"## Use case: ...","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"key":"xdxKRgkBjP"}],"key":"AdLFsxJJZF"},{"type":"heading","depth":2,"position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"children":[{"type":"text","value":"❓ User question","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"Bc2WBEw7VL"}],"identifier":"id-user-question","label":"❓ User question","html_id":"id-user-question","implicit":true,"key":"mCyM90PaUg"},{"type":"paragraph","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"children":[{"type":"text","value":"User question, or User questions, if more than one question is answered in the assessment, or if a second question helps clarify the aim of the assessment. The question or questions are bold and highlighted with bullet points.","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"key":"hQuN4Mzzva"}],"key":"EvfJ8IAPIf"},{"type":"heading","depth":2,"position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"children":[{"type":"text","value":"Context text (no heading or icon)","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"key":"FnrIrnvpXy"}],"identifier":"context-text-no-heading-or-icon","label":"Context text (no heading or icon)","html_id":"context-text-no-heading-or-icon","implicit":true,"key":"HredXHhHDp"},{"type":"paragraph","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"children":[{"type":"text","value":"A section of text with no heading which appears after the user question and before the quality assessment statement. References can be used to link to examples of relevant literature or example applications relevant to the use case and user question. It should be as short as possible, but contain enough information for users to understand the context of the assessment and the main approach to be used. Together with the assessment title, use case and user question, and assessment statement all key information should be contained at the top of the assessment.","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"QEb1PKGKVC"}],"key":"rYnLgvIZW9"},{"type":"heading","depth":2,"position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"children":[{"type":"text","value":"📢 Quality assessment statement","position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"key":"uq4XRGaxBb"}],"identifier":"id-quality-assessment-statement","label":"📢 Quality assessment statement","html_id":"id-quality-assessment-statement","implicit":true,"key":"G10rRF4Vzz"},{"type":"paragraph","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"children":[{"type":"text","value":"Key results and guidance including an answer to the user question, as a bulleted list.","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"key":"wwCq37C5TB"}],"key":"P9R3uYfWlF"},{"type":"admonition","kind":"note","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Note","key":"KOW5I75ef5"}],"key":"HCWzu2zheD"},{"type":"paragraph","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"children":[{"type":"text","value":"The blue notification box that contains the quality assessment statement bullet points will not appear in GitHub, but will be rendered when the Jupyter Book page is created.","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"k6Sk0u7kAk"}],"key":"WynwiRdrMg"}],"key":"ozzmvryUWn"},{"type":"heading","depth":2,"position":{"start":{"line":67,"column":1},"end":{"line":67,"column":1}},"children":[{"type":"text","value":"Figure (no heading or icon)","position":{"start":{"line":67,"column":1},"end":{"line":67,"column":1}},"key":"keUjV9Rvoq"}],"identifier":"figure-no-heading-or-icon","label":"Figure (no heading or icon)","html_id":"figure-no-heading-or-icon","implicit":true,"key":"hnmzcPWsRq"},{"type":"paragraph","position":{"start":{"line":69,"column":1},"end":{"line":69,"column":1}},"children":[{"type":"text","value":"A key figure should be included if possible, acting as a ‘graphical abstract’ for the assessment. This could be a figure generated later in the code, or from an external source (if licensing allows reproduction) - in this case the source should be cited in the caption. Images should be dragged and dropped into the markdown cell, which creates an ‘attachment code’, and the external file is not needed.","position":{"start":{"line":69,"column":1},"end":{"line":69,"column":1}},"key":"qpPtyFki8B"}],"key":"irrJJSMZes"},{"type":"paragraph","position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"children":[{"type":"text","value":"Drag and drop the image from a file browser into the cell. If the image file already includes a figure number and the caption then the simple default syntax can be used to add the figure (","position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"key":"A2Hhiv3wpQ"},{"type":"inlineCode","value":"![](attachment:... ID from drag and drop)","position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"key":"D6FY53TtVq"},{"type":"text","value":"). Otherwise, figure formatting can be used (see the template), where the attachment code from the drag and drop needs to be wrapped in the figure syntax. This approach should also be followed if images not generated by code are included later in the assessment.","position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"key":"m6bfjrPp4q"}],"key":"vr0PZ6Z0mM"},{"type":"paragraph","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"children":[{"type":"text","value":"The figure should always include an explanatory caption and/or title.","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"key":"NTqSkxZLJU"}],"key":"l5T7JTxNtE"},{"type":"admonition","kind":"note","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Note","key":"jWySI5gDpr"}],"key":"bwZa9wFBxT"},{"type":"paragraph","position":{"start":{"line":76,"column":1},"end":{"line":76,"column":1}},"children":[{"type":"text","value":"The figure formatting will not render in Github, but will work when the Jupyter Book page is built. Also note that the figure numbering is automatic, and starts at 1 in each Notebook.","position":{"start":{"line":76,"column":1},"end":{"line":76,"column":1}},"key":"HrpPM3KpL4"}],"key":"kuIGwKA2xz"}],"key":"QdWM2POGoP"},{"type":"heading","depth":2,"position":{"start":{"line":79,"column":1},"end":{"line":79,"column":1}},"children":[{"type":"text","value":"📋 Methodology","position":{"start":{"line":79,"column":1},"end":{"line":79,"column":1}},"key":"wBYV3ea7G6"}],"identifier":"id-methodology","label":"📋 Methodology","html_id":"id-methodology","implicit":true,"key":"qAB8vHlBhd"},{"type":"paragraph","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"children":[{"type":"text","value":"Some text to introduce the methodology, including relevant sources, followed by a numbered list of the analysis steps under the ‘analysis and results’ section. The headings of each list item should link to the sections within ‘Analysis and results’ - this needs to be done manually. Extra steps or explanations can be added in the bullets between each numbered item.","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"key":"LOmfFXbECC"}],"key":"tsLBTZLEIG"},{"type":"paragraph","position":{"start":{"line":83,"column":1},"end":{"line":83,"column":1}},"children":[{"type":"text","value":"The syntax for the link in the methodology list is: ","position":{"start":{"line":83,"column":1},"end":{"line":83,"column":1}},"key":"akrFfCXGCq"},{"type":"inlineCode","value":"[](section-1)","position":{"start":{"line":83,"column":1},"end":{"line":83,"column":1}},"key":"ylUbWlcXIU"},{"type":"text","value":", where no text in the square brackets is needed (the heading of the corresponding section in ‘Analysis and Results’ will be shown automatically), and the label in the circle brackets is the manually set label used later to identify the section in question like","position":{"start":{"line":83,"column":1},"end":{"line":83,"column":1}},"key":"lvBaQJMZNb"}],"key":"XuBx1pgNya"},{"type":"code","lang":"md","value":"(section-1)=\n### 1. Section 1 title","position":{"start":{"line":85,"column":1},"end":{"line":88,"column":1}},"key":"f2jYsFtmwx"},{"type":"heading","depth":2,"position":{"start":{"line":90,"column":1},"end":{"line":90,"column":1}},"children":[{"type":"text","value":"📈 Analysis and results","position":{"start":{"line":90,"column":1},"end":{"line":90,"column":1}},"key":"YGAI2vFheP"}],"identifier":"id-analysis-and-results","label":"📈 Analysis and results","html_id":"id-analysis-and-results","implicit":true,"key":"dvM7LpcQ1z"},{"type":"paragraph","position":{"start":{"line":92,"column":1},"end":{"line":92,"column":1}},"children":[{"type":"text","value":"A series of subsections with the same titles as in the listen in the methodology. In turn, these can have their own subsections. Code cells will be collapsed when the Jupyter Book is built. The final results should be clearly presented and discussed, supporting (but not repeating), the quality assessment statement.","position":{"start":{"line":92,"column":1},"end":{"line":92,"column":1}},"key":"PgEnvMZNHM"}],"key":"RN166S4KRS"},{"type":"heading","depth":2,"position":{"start":{"line":94,"column":1},"end":{"line":94,"column":1}},"children":[{"type":"text","value":"ℹ️ If you want to know more","position":{"start":{"line":94,"column":1},"end":{"line":94,"column":1}},"key":"dq6874W3Gx"}],"identifier":"id-if-you-want-to-know-more","label":"ℹ️ If you want to know more","html_id":"id-if-you-want-to-know-more","implicit":true,"key":"TtvTXlSXM2"},{"type":"paragraph","position":{"start":{"line":96,"column":1},"end":{"line":96,"column":1}},"children":[{"type":"text","value":"Including a key resources subsection, which can link to suggested further reading, code packages used, and the relevant CDS catalogue entries. Try to link to relevant applications of the data, such as the C3S Climate Atlas, for projections, or the relevant parts of the European State of the Climate report for some ECVs.","position":{"start":{"line":96,"column":1},"end":{"line":96,"column":1}},"key":"qPB9oi31ge"}],"key":"O2hmvQYScB"},{"type":"paragraph","position":{"start":{"line":98,"column":1},"end":{"line":98,"column":1}},"children":[{"type":"text","value":"Including a references subsection, which is a numbered list of the references used throughout the text. However, the references in the text should link to the external source, rather than the references list at the bottom of the assessment.","position":{"start":{"line":98,"column":1},"end":{"line":98,"column":1}},"key":"urv0PiPbLN"}],"key":"mqn2b3J0ss"}],"key":"mkEIqqiFOR"}],"key":"RlJRw4jobi"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Applications","short_title":"Quality assessments for C3S Applications","url":"/applications/application","group":"➡️ Applications"},"next":{"title":"Unique quality assessment title (to be finalised by C3S), including approximately ‘data stream’ or ‘key variable/index’, ‘quality area’ and ‘application area’","short_title":"Template","url":"/templates/template","group":"Quality assessment template"}}},"domain":"http://localhost:3000"}